{
  "name": "@campusmarkt/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:mutation": "stryker run",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "openapi": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@campusmarkt/contracts": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "10.1.6",
    "@fastify/static": "10.1.5",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/type-provider-typebox": "5.2.0",
    "@fastify/websocket": "11.3.4",
    "@node-rs/argon2": "2.2.2",
    "@sinclair/typebox": "0.34.52",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "nodemailer": "10.0.16",
    "pg": "8.23.1",
    "pg-boss": "10.4.2",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.15.6",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "17.4.3",
    "pino-pretty": "13.2.0",
    "tsx": "4.21.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
