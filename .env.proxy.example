# Start mit Reverse Proxy (Profil proxy, ADR-0017, REQ-OPS-009):
#   docker compose --env-file .env.proxy.example --profile proxy up -d
# Ohne diese Werte sähe die App hinter dem Proxy nur dessen IP-Adresse (Rate-Limits je IP greifen dann für alle)
# und Links in E-Mails zeigten auf http://localhost:8080.
TRUST_PROXY=true
PUBLIC_URL=https://campusmarkt.localhost:8443
PROXY_HTTPS_PORT=8443
PROXY_HTTP_PORT=8088
