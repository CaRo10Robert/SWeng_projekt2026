# Beispielkonfiguration. Für Docker Compose optional (Defaults in compose.yaml),
# für `pnpm dev` nach .env kopieren. Keine Secrets ins Repo oder Image (REQ-SEC-010).

# Ports auf dem Host (bei Konflikten ändern)
APP_PORT=8080
MAILPIT_PORT=8025

# Startmodus: all | api | worker
APP_MODE=all
PORT=8080
PUBLIC_URL=http://localhost:8080
DATABASE_URL=postgres://campusmarkt:campusmarkt@localhost:5432/campusmarkt

# SMTP: im Beispiel Mailpit, im Echtbetrieb ein Relay (REQ-NOTI-007)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=CampusMarkt HWG LU <no-reply@campusmarkt.local>

# Demo
SEED_DEMO=true
DEMO_MODE=true

# Safari akzeptiert Secure-Cookies auf http://localhost nicht → dort COOKIE_SECURE=false
COOKIE_SECURE=true
LOG_LEVEL=info
